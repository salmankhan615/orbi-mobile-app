{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "env": {
          "GOOGLE_SERVICES_JSON": "./google-services.json"
        }
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "env": {
          "GOOGLE_SERVICES_JSON": "./google-services.json"
        }
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "env": {
          "GOOGLE_SERVICES_JSON": "./google-services.json"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
